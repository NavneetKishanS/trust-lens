# Exasol (leave EXASOL_DSN empty to use local DuckDB at data/trustlens.duckdb)
EXASOL_DSN=
EXASOL_USER=sys
EXASOL_PASSWORD=

# LLM: bedrock | anthropic | stub
LLM_PROVIDER=stub
AWS_REGION=eu-central-1
ANTHROPIC_API_KEY=

# ElevenLabs (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=1
