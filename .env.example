# Exasol (leave EXASOL_DSN empty to use local DuckDB at data/trustlens.duckdb)
EXASOL_DSN=
EXASOL_USER=sys
EXASOL_PASSWORD=
# or read it from a file instead (Exasol starter kit: ~/.exasol-starter-kit/credentials/personal_sys_password)
EXASOL_PASSWORD_FILE=
# self-signed certificate (local Exasol Personal): false skips verification; or put the fingerprint in the DSN
EXASOL_SSL_VERIFY=true

# LLM: bedrock | anthropic | stub
LLM_PROVIDER=stub
AWS_REGION=eu-central-1
# AWS Workshop Studio sandbox: AWS_REGION=us-west-2, AWS_PROFILE=<your profile>, BEDROCK_CLIENT=runtime,
# BEDROCK_MODEL_ID=us.anthropic.claude-opus-5-5 (the bare model ID only works through an inference profile there)
AWS_PROFILE=
BEDROCK_CLIENT=runtime
BEDROCK_MODEL_ID=
ANTHROPIC_API_KEY=

# Pseudonymisation salt for the anonymised pool (same value for the whole team)
ANON_SALT=

# Data
SYNTHEA_CSV_DIR=data/synthea/csv

# Frontend (after the MVP freeze)
NEXT_PUBLIC_API_BASE=http://localhost:8000
